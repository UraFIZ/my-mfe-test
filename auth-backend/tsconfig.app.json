{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../dist/out-tsc",
    "module": "nodenext",
    "target": "es2020",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "lib": ["es2020"],
    "noEmitOnError": false
  },
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ],
  "include": ["src/**/*.ts"]
}
